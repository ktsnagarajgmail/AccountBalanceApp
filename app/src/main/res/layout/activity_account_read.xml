<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AccountRead">

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:id="@+id/bottom_navigation"
        app:itemBackground="@color/teal_700"
        app:itemIconTint="@drawable/selector"
        app:itemTextColor="@drawable/selector"
        app:menu="@menu/menu_navigation" />
    
    <com.google.android.material.imageview.ShapeableImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="50dp"
        android:layout_marginStart="30dp"
        android:background="@color/teal_200"
        android:id="@+id/profileImageView"
        android:src="@drawable/profile"
        app:shapeAppearanceOverlay="@style/circular"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:id="@+id/accReadLinear"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="70dp"
        android:layout_toRightOf="@+id/profileImageView">
        <TextView
            android:id="@+id/txtViewNameAccount"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:hint="Name"
            android:layout_marginStart="15dp"
            android:textSize="18sp" />
        <TextView
            android:id="@+id/txtViewEmailAccount"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:layout_marginTop="15dp"
            android:layout_marginStart="15dp"
            android:textSize="14sp" />
        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:id="@+id/divider_one"
            app:dividerColor="@color/grey"
            android:layout_marginTop="15dp"/>
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Feedback"
        android:layout_below="@id/profileImageView"
        android:textSize="18dp"
        android:textStyle="bold"
        android:layout_marginStart="20dp"
        android:layout_marginTop="50dp"/>
    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:text="Rate AccountBalance"
        android:textAllCaps="false"
        android:layout_marginStart="40dp"
        android:layout_below="@+id/profileImageView"
        android:layout_marginTop="80dp"
        android:id="@+id/btn_rate_account_balance"
        android:drawableLeft="@drawable/star"/>
    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:text="Contact Support Team"
        android:textAllCaps="false"
        android:layout_marginStart="40dp"
        android:layout_below="@+id/btn_rate_account_balance"
        android:id="@+id/btn_contact_support_team"
        android:drawableLeft="@drawable/baseline_email_24"/>


    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:id="@+id/divider_two"
        app:dividerColor="@color/grey"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp"
        android:layout_below="@id/btn_contact_support_team"/>

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Delete Account"
        android:layout_marginStart="20dp"
        android:textAllCaps="false"
        android:id="@+id/btn_act_read_delete_account"
        android:layout_below="@+id/divider_two"
        android:layout_marginTop="10sp"
        android:textSize="16sp"
        style="@style/Widget.MaterialComponents.Button.TextButton"/>
    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:textSize="16sp"
        android:text="Logout"
        android:id="@+id/btn_act_read_logout"
        android:textAllCaps="false"
        android:textColor="@color/red"
        android:drawableLeft="@drawable/logout"
        android:layout_below="@+id/btn_act_read_delete_account"/>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:id="@+id/divider_three"
        app:dividerColor="@color/grey"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:layout_below="@id/btn_act_read_logout"/>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@+id/divider_three"
        android:gravity="center"
        android:layout_marginTop="50dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Made with Nexzsoft"
            android:textSize="12dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:textColor="@color/teal_700"
            android:text="Privacy Policy"
            android:id="@+id/tv_act_read_privacy_policy"
            android:textSize="12dp"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Release version 1.0.0"
            android:textSize="12dp"/>
    </LinearLayout>
</RelativeLayout>
